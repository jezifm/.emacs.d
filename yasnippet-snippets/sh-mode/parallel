# -*- mode: snippet -*-
# name: parallel
# key: parallel
# --
function open_sem {
    mkfifo pipe-\$\$
    exec 3<>pipe-\$\$
    rm pipe-\$\$
    local i=\$1
    for((;i>0;i--)); do
        printf %s 000 >&3
    done
}
function run_with_lock {
    local x
    # this read waits until there is something to read
    read -u 3 -n 3 x && ((0==x)) || exit \$x
    (
     ( "\$@"; )
    # push the return code of the command to the semaphore
    printf '%.3d' \$? >&3
    )&
}

N=4
open_sem \$N
for thing in {a..g}; do
    run_with_lock task \$thing
done
